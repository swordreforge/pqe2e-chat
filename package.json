  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
